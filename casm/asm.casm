// Assemble with -byteSize=16: one word per .out, so labels and .advance are in
// words, like the addresses the machine uses. With -byteSize=8 every label is a
// byte address, twice the word it names: the code lands at word 0x80 instead of
// 0x100, and every label embedded by LIT or JMP points at the wrong word.

.num 16 "0x" ""
.num 2 "0b" ""

.inline OPC
.with ( opc: Ints, addr12: Ints ) -> {
    .if addr12 >= 4096 {
        .error addr12, "Cannot refer to address outside the first 4096 positions";
    }

    .return ( opc << 8 ) + addr12;
}

// ADR emette una parola grezza contenente un indirizzo: serve per il vettore di
// reset, perche' .dw non risolve gli identificatori.
.inline WORD
.with ( value: Ints ) -> {
    .return value;
}

.opcode ADR {{ addr16 }}
.with ( addr16 : Ints ) -> {
    .out [ .expr WORD(addr16) ];
}

// Binary ALU
.opcode ADD {{ addr12 }}
.with ( addr12 : Ints ) -> {
    .out [ .expr OPC(0x00, addr12) ];
}

.opcode SUB {{ addr12 }}
.with ( addr12 : Ints ) -> {
    .out [ .expr OPC(0x10, addr12) ];
}

.opcode AND {{ addr12 }}
.with ( addr12 : Ints ) -> {
    .out [ .expr OPC(0x20, addr12) ];
}

.opcode NOR {{ addr12 }}
.with ( addr12 : Ints ) -> {
    .out [ .expr OPC(0x30, addr12) ];
}

.opcode LIT {{ addr12 }}
.with ( addr12 : Ints ) -> {
    .if addr12 >= 4096 {
        .error addr12, "Cannot load literal outside the first 4096 values";
    }
    .out [ .expr OPC(0x50, addr12) ];
}

.opcode INC {{ addr12 }}
.with ( addr12 : Ints ) -> {
    .out [ .expr OPC(0x60, addr12) ];
}

.opcode SHR {{ addr12 }}
.with ( addr12 : Ints ) -> {
    .out [ .expr OPC(0x70, addr12) ];
}

.opcode JMP {{ addr12 }}
.with ( addr12 : Ints ) -> {
    .out [ .expr OPC(0x80, addr12) ];
}

.opcode JPI {{ addr12 }}
.with ( addr12 : Ints ) -> {
    .out [ .expr OPC(0x90, addr12) ];
}

.opcode JNZ {{ addr12 }}
.with ( addr12 : Ints ) -> {
    .out [ .expr OPC(0xA0, addr12) ];
}

.opcode JZE {{ addr12 }}
.with ( addr12 : Ints ) -> {
    .out [ .expr OPC(0xB0, addr12) ];
}

.opcode LDA {{ addr12 }}
.with ( addr12 : Ints ) -> {
    .out [ .expr OPC(0xC0, addr12) ];
}

.opcode LDI {{ addr12 }}
.with ( addr12 : Ints ) -> {
    .out [ .expr OPC(0xD0, addr12) ];
}

.opcode STA {{ addr12 }}
.with ( addr12 : Ints ) -> {
    .out [ .expr OPC(0xE0, addr12) ];
}

.opcode STI {{ addr12 }}
.with ( addr12 : Ints ) -> {
    .out [ .expr OPC(0xF0, addr12) ];
}